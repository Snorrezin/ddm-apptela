<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/bt_return"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:contentDescription="RETORNAR"
            app:srcCompat="@drawable/bt_back" />

        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/bt_return"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="Registro de Filmes"
            android:textSize="30dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_filme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_titulo"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="90dp"
            android:hint="Nome do Filme"
            android:inputType="text" />

        <EditText
            android:id="@+id/edit_diretor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/edit_filme"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="40dp"
            android:hint="Nome do Diretor"
            android:inputType="text" />

        <ImageView
            android:id="@+id/bt_send"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_below="@id/edit_diretor"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="40dp"
            app:srcCompat="@drawable/bt_send" />


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>